# uwuFeed environment
#
# This is the VPS copy, read by the workers and by both bots. Vercel reads
# its own variables from project settings; see main-site/.env.example for
# that shorter list.
#
# Every value says where it comes from. Copy to .env, fill in, and
# chmod 600 it.

# ---- Supabase ----
#
# The first two come from: Supabase dashboard, your project, Project
# Settings (the gear), then API.

# Listed there as "Project URL". Looks like https://abcdefgh.supabase.co
SUPABASE_URL=

# The secret key on that page, labelled service_role rather than anon. It
# bypasses row level security entirely, so it belongs on this box and in
# Vercel and nowhere else.
SUPABASE_SERVICE_KEY=

# The connection strings come from a different page: Project Settings,
# Database, then the connection string section, or the Connect button at
# the top of the dashboard. Both contain your database password, which is
# the one set when the project was created and can be reset on that page.

# Transaction pooler, port 6543. Reserved for Vercel if anything there ever
# needs raw SQL. Nothing uses it yet.
SUPABASE_DB_URL_POOLER=

# Direct connection, port 5432. The poller needs this one specifically:
# `for update skip locked` holds row locks across statements, and
# transaction mode pooling breaks that in ways that are unpleasant to
# debug.
SUPABASE_DB_URL_DIRECT=

# ---- Shared with the site ----
#
# These four are generated once and used in more than one place. Generate
# them with any of:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
#
# A separate value for each. See docs/content/self-hosting.md for what
# rotating each one costs.

# The site's public origin, no trailing slash. Must be the custom domain:
# deployment protection covers everything except custom domains, so a
# *.vercel.app value sends every WebSub hub to a login page and the push
# tier silently receives nothing.
PUBLIC_BASE_URL=https://feed.uwuapps.org

# Bearer token for the privileged endpoints under /api/sources/. Same value
# here and in Vercel, or the bots cannot add sources.
ADMIN_TOKEN=

# Bearer token Vercel sends on scheduled cron invocations. Vercel only,
# listed here for completeness.
CRON_SECRET=

# HMAC key signing the source id in the WebSub callback URL. Vercel only.
# Rotating it invalidates every callback URL hubs already hold, so the push
# tier goes quiet for every source at once.
WEBSUB_CALLBACK_SECRET=

# HMAC key for account link tokens. The site signs, the bots verify. Same
# value in all three places or every /link is rejected as forged.
LINK_TOKEN_SECRET=

# Bot username without the @, so the site can build a one tap link.
# Vercel only. Whatever you told BotFather.
TELEGRAM_BOT_USERNAME=

# Email for password reset codes, through the Google Workspace mailbox the
# project already has rather than a sending service. Vercel only. The full
# setup, including the one scope to authorise for domain wide delegation,
# is in main-site/.env.example.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GMAIL_SENDER=
GMAIL_FROM_NAME=uwuFeed

# Both bot tokens are also needed on Vercel, not only on the VPS, so the
# site can send a reset code as a direct message. TELEGRAM_BOT_TOKEN and
# DISCORD_BOT_TOKEN are further down under their own bots.

# What a password reset does when there is nowhere private to send a code,
# meaning no linked identity and no email configured above. Vercel only.
#
# on   reset the password to the account's username and show it to whoever
#      asked. Anybody who knows an email address can do this.
# off  refuse, which makes a forgotten password unrecoverable without a
#      linked chat.
#
# TELEGRAM_BOT_TOKEN below also has to be set on Vercel for the good path to
# work, not only on the VPS.
RESET_WITHOUT_CHAT=on

# Lease length to request from a hub, in seconds. Just a number, ten days.
WEBSUB_LEASE_SECONDS=864000

# Contact address in the outbound user agent, so a feed host can write to
# you before deciding to block you. Any address you actually read.
USER_AGENT_CONTACT=mailto:augy@augystudios.com

# ---- Poller tuning ----
#
# Both optional, both just numbers. Raising concurrency raises the outbound
# request rate against feed hosts, which is the thing most likely to get
# this box blocked, so raise it carefully.

# Sources claimed per cycle.
POLLER_BATCH_SIZE=50

# Feeds fetched at once within a cycle.
POLLER_CONCURRENCY=10

# ---- Delivery ----

# Read by the dispatcher to deliver items, and by the Vercel crons to
# report operational problems, so it has to be set in both places.
#
# From Discord: Server Settings, Integrations, Webhooks, New Webhook, then
# Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Web push. Generate the pair once with:
#   npx web-push generate-vapid-keys
# Keep them: rotating invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:augy@augystudios.com

# ntfy. The public instance, or your own if you self host one.
NTFY_BASE_URL=https://ntfy.sh

# ---- Twitch, for going live alerts ----
#
# From https://dev.twitch.tv/console/apps: Register Your Application, set
# the OAuth Redirect URL to your site (it is unused, but required), category
# Application Integration. Then Manage to see the client id and generate a
# secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# You generate this one, like the other secrets. Twitch signs every
# EventSub notification with it, and it is set when a subscription is
# created, so changing it means recreating every Twitch subscription.
TWITCH_EVENTSUB_SECRET=

# ---- Additional platforms ----

# RSSHub, for sites that publish nothing machine readable. Run the compose
# file in infra/rsshub/ and point this at it. Leave empty to switch the
# feature off: unmapped URLs then just report no feed found.
#
# Bound to localhost on purpose. An RSSHub reachable from the internet gets
# found and used by strangers, and then the sites it scrapes block your VPS
# rather than theirs.
RSSHUB_BASE_URL=http://127.0.0.1:1200

# Bluesky Jetstream. One connection covers every Bluesky source, so there
# is nothing per account to configure. Change only to use a different
# public instance.
BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# ---- Telegram bot ----

# From https://my.telegram.org: sign in, open "API development tools",
# create an application, then copy App api_id and App api_hash. These
# belong to your Telegram account rather than to the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From @BotFather: /newbot for a new one, or /mybots then API Token for an
# existing one. /revoke there if it ever leaks.
TELEGRAM_BOT_TOKEN=

# Paths and names, no source needed.
TELEGRAM_SQLITE_PATH=bot.sqlite3
TELEGRAM_SESSION_NAME=uwufeed-telegram

# ---- Discord bot ----

# From https://discord.com/developers/applications: New Application, Bot
# tab, Reset Token. Shown once. Leave every privileged intent off.
DISCORD_BOT_TOKEN=

# Optional. A test server id so slash commands sync instantly while
# developing. Enable Developer Mode in Discord settings, then right click
# the server icon and Copy Server ID. Leave empty in production.
DISCORD_DEV_GUILD_ID=

DISCORD_SQLITE_PATH=bot.sqlite3

# ---- Shown to users ----

WEB_APP_URL=https://feed.uwuapps.org
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# Free account cap, matching the site.
MAX_SOURCES_PER_USER=50
