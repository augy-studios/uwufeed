# uwuFeed environment
#
# Copy to .env and fill in. Never commit the result.
# Vercel functions read their variables from project settings rather than
# from a file; this is the VPS copy and the local development copy.

# ---- Supabase ----

# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key. Bypasses row level security entirely, so it goes on the
# server and nowhere else. Never in the browser and never in a bot message.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler connection string. Reserved for Vercel if anything
# there ever needs raw SQL. Nothing uses it yet.
SUPABASE_DB_URL_POOLER=

# Direct connection string, for the VPS workers. The poller needs this one:
# for update skip locked does not survive transaction mode pooling.
SUPABASE_DB_URL_DIRECT=

# ---- Site ----

# Public origin of the deployed site, no trailing slash. This is what a hub
# calls back, so a wrong value means no push notification ever arrives.
PUBLIC_BASE_URL=https://uwufeed.app

# Bearer token for the privileged endpoints under /api/sources/. They fail
# closed if this is unset, so an unconfigured deployment is not an open one.
ADMIN_TOKEN=

# Bearer token Vercel sends on scheduled cron invocations.
CRON_SECRET=

# Contact address in the outbound user agent, so a feed host can write to
# you before deciding to block you.
USER_AGENT_CONTACT=mailto:you@example.com

# ---- WebSub ----

# HMAC key used to sign the source id in the callback URL. Without it the
# receiver would accept any source id anyone cared to guess.
WEBSUB_CALLBACK_SECRET=

# Lease length to request from a hub, in seconds. Ten days is the cap most
# hubs apply anyway.
WEBSUB_LEASE_SECONDS=864000

# ---- Delivery ----

# Phase 1 delivers everything to this one Discord webhook. Read by the
# dispatcher on the VPS, not by the Discord bot.
DISCORD_WEBHOOK_URL=

# Web push, Phase 4. Generate a VAPID key pair once and keep it forever;
# rotating it invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ntfy, Phase 6. Base URL of the instance, public or self hosted.
NTFY_BASE_URL=https://ntfy.sh

# ---- Telegram bot ----

# From my.telegram.org, API development tools. These belong to your account
# rather than to the bot, and Telethon needs both.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From BotFather. /revoke there if it ever leaks.
TELEGRAM_BOT_TOKEN=

# Bot local SQLite file: button state, chat preferences, scheduling.
TELEGRAM_SQLITE_PATH=bot.sqlite3

# Name of the Telethon session file. That file is a live credential.
TELEGRAM_SESSION_NAME=uwufeed-telegram

# ---- Discord bot ----

# From the Discord developer portal, Bot tab. Shown once.
DISCORD_BOT_TOKEN=

# Bot local SQLite file: view state, guild preferences, scheduling.
DISCORD_SQLITE_PATH=bot.sqlite3

# Optional. A test server id, so slash commands sync instantly instead of
# waiting up to an hour on the global cache. Leave empty in production.
DISCORD_DEV_GUILD_ID=

# ---- Links shown in both bots ----

WEB_APP_URL=https://uwufeed.app
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo
