# discord-bot environment
#
# Copy to discord-bot/.env and fill in. Runs on the VPS, not on Vercel.
#
# Most of this is not read yet. It is here now so the shape is known and
# the values can be set once.

# ---- Discord ----

# From https://discord.com/developers/applications
#   1. New Application, name it uwuFeed.
#   2. Bot tab, Reset Token, copy the value. It is shown once.
#   3. Leave every privileged intent off. Slash commands do not need
#      message content, and asking for an intent you never use means a
#      review for nothing once the bot is in a hundred servers.
#
# To add it to a server: OAuth2, URL Generator, scopes bot and
# applications.commands, permissions Send Messages, Embed Links and Use
# Slash Commands. Open the generated URL.
DISCORD_BOT_TOKEN=

# Optional, and only useful while developing. A test server id, so slash
# commands sync there instantly instead of waiting up to an hour on the
# global cache.
#
# To get it: Discord User Settings, Advanced, turn on Developer Mode, then
# right click the server icon and Copy Server ID. Leave empty in
# production.
DISCORD_DEV_GUILD_ID=

# ---- Supabase ----
#
# Supabase dashboard, your project, Project Settings, then API. The same
# project the site and the Telegram bot use: sources, items and
# subscriptions are shared, only view state and preferences are local.

# Listed as "Project URL".
SUPABASE_URL=

# The secret service_role key on that page, not the anon one.
SUPABASE_SERVICE_KEY=

# ---- Shared with the site ----
#
# Neither is generated here. Both are copied from the main-site Vercel
# project, byte for byte. Making fresh ones means the site rejects
# everything this bot sends.

# The site's public origin, for /add, which hands URLs to
# /api/sources/resolve rather than detecting hubs itself.
PUBLIC_BASE_URL=https://feed.uwuapps.org

# Same value as ADMIN_TOKEN in Vercel.
ADMIN_TOKEN=

# Same value as LINK_TOKEN_SECRET in Vercel.
LINK_TOKEN_SECRET=

# ---- Local state ----

# Bot local SQLite: view state, per guild preferences, scheduling, and the
# guild to account mapping. No feed data.
DISCORD_SQLITE_PATH=bot.sqlite3

# ---- Shown to users ----

WEB_APP_URL=https://feed.uwuapps.org
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# ---- Not here ----
#
# DISCORD_WEBHOOK_URL is deliberately absent. Delivery to Discord does not
# go through this bot: the dispatcher posts to a webhook directly, because
# webhook rate limits are friendlier than the bot gateway. That variable
# belongs to the workers and to the Vercel crons.
