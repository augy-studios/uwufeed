# main-site environment
#
# These are the variables to set in the Vercel project settings for
# uwufeed-main. Copy this file to main-site/.env for `vercel dev`, which
# reads its environment from this directory.
#
# Every value below says where it comes from. Broadly there are two kinds:
# ones you copy out of a dashboard, and four you generate yourself.
#
# Nothing here belongs in the browser. Every one of these is read only by
# a serverless function.

# ---- Supabase ----
#
# Both come from the same page: Supabase dashboard, your project, Project
# Settings (the gear), then API.

# Listed there as "Project URL". Looks like https://abcdefgh.supabase.co
SUPABASE_URL=

# The secret key on that page, the one labelled service_role rather than
# anon. It bypasses row level security entirely, which is how the functions
# read at all, since RLS is on with no policies.
#
# If you ever paste this into a browser or a chat, rotate it immediately.
SUPABASE_SERVICE_KEY=

# ---- Site identity ----

# The public origin, no trailing slash. This is what WebSub hubs call back.
#
# It must be the custom domain. The project has deployment protection
# enabled for everything except custom domains, so a *.vercel.app value
# here sends every hub to a login page, the subscription silently fails,
# and nothing is ever logged because the request never reaches the app.
PUBLIC_BASE_URL=https://feed.uwuapps.org

# ---- The four you generate ----
#
# Nothing hands you these. They are random strings you make once and paste
# in. Any of these produces 32 random bytes:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
#
# PowerShell, if that is what you have open:
#   $b=[byte[]]::new(32);([Security.Cryptography.RNGCryptoServiceProvider]::new()).GetBytes($b);[Convert]::ToBase64String($b)
#
# Generate a separate value for each. Reusing one means leaking one leaks
# both, and they have very different blast radii.

# Bearer token for the privileged endpoints under /api/sources/. They fail
# closed if this is unset, answering 503 rather than running
# unauthenticated.
#
# Copy the same value into telegram-bot/.env. The bot sends it when
# resolving a URL, so a mismatch makes /add fail with an unhelpful 401.
ADMIN_TOKEN=

# Vercel sends this as a bearer token on scheduled cron invocations, purely
# because a variable with this name exists. Unset means all four crons
# answer 401 and quietly do nothing, which looks exactly like them working.
#
# Vercel only. Nothing else reads it, so rotating it is free.
CRON_SECRET=

# HMAC key that signs the source id in the WebSub callback URL. Without it
# the receiver would accept any source id anyone cared to guess.
#
# Vercel only, but rotating it is expensive: every callback URL a hub
# already holds stops verifying, so the push tier goes quiet for every
# source at once and takes up to ten days to heal as leases renew. Set it
# once and leave it alone unless it leaks.
WEBSUB_CALLBACK_SECRET=

# HMAC key for account link tokens. This site signs them, the bots verify
# them, and neither talks to the other.
#
# Copy the same value into both bot .env files. A mismatch means every
# /link attempt is rejected as forged.
LINK_TOKEN_SECRET=

# ---- Optional ----

# Lease length to request from a hub, in seconds. Defaults to ten days,
# which is the cap most hubs apply anyway. No source needed, just a number.
WEBSUB_LEASE_SECONDS=864000

# Contact address in the outbound user agent, so a feed host can write to
# you before deciding to block you. Any address you actually read.
USER_AGENT_CONTACT=mailto:augy@augystudios.com

# Where the crons report operational problems, most importantly a lease
# renewal that is failing. Without it, renewal still runs but goes silent
# when it breaks, which defeats the point of it alerting.
#
# From Discord: Server Settings, Integrations, Webhooks, New Webhook, then
# Copy Webhook URL. The same value goes on the VPS for the dispatcher.
DISCORD_WEBHOOK_URL=

# The bot's username without the @, so the site can build a one tap link to
# it. Whatever you told BotFather when you ran /newbot, for example
# uwufeed_bot. Linking still works without it by pasting the token.
TELEGRAM_BOT_USERNAME=

# The same bot tokens the bots themselves run on, so the site can send a
# password reset code as a direct message. Without them, an account that
# linked a bot still falls through to the weaker paths below, so set them if
# you set anything.
#
# A reset is only ever sent to a person, never to a group or a server
# channel, which is why these are needed rather than the webhook the
# dispatcher already uses.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ---- Discord sign in ----
#
# Continue with Discord on the web app, and the server dashboard behind it.
# From the same application as the bot, on the OAuth2 tab.
#
# Add this exact redirect URL there, or Discord refuses the exchange:
#   https://feed.uwuapps.org/api/auth/discord/callback
#
# Scopes requested are identify and guilds, nothing else. No email scope:
# a Discord address is not something this project needs to hold.
#
# Leave empty to switch Discord sign in off. Email and password, passkeys
# and recovery codes all keep working without it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Email, through the Workspace mailbox ----
#
# Used for password reset codes and nothing else. No third party sending
# service: this goes through the Google Workspace account the project
# already has, over the Gmail API, which is HTTPS and needs no dependency.
# SMTP would need an SMTP client, which these functions do not have.
#
# Setup, once:
#
#  1. Google Cloud console, a project, enable the Gmail API.
#  2. IAM, Service Accounts, create one, then Keys, Add key, JSON. The file
#     it downloads holds the two values below.
#  3. Copy the service account's Unique ID from the same page.
#  4. Workspace Admin console: Security, Access and data control, API
#     controls, Manage Domain Wide Delegation, Add new. Paste the Unique ID
#     and authorise exactly this scope:
#       https://www.googleapis.com/auth/gmail.send
#
# Leave any of these empty to switch email off, in which case reset falls
# through to the username path below.

# client_email from the downloaded JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# private_key from the same JSON, including the BEGIN and END lines. Paste
# it as it appears there: Vercel keeps the escaped newlines and the code
# unescapes them.
GOOGLE_PRIVATE_KEY=

# The Workspace mailbox the mail is sent as. A service account has no
# mailbox of its own, so it acts as this user, and this address is what
# recipients see in From.
#
# Prefer a dedicated alias on a subdomain over a human mailbox. Reset mail
# that lands in spam costs the sending domain reputation, and that is the
# same domain real correspondence comes from.
GMAIL_SENDER=

# Display name in front of the address. Optional.
GMAIL_FROM_NAME=uwuFeed

# ---- Password reset ----
#
# What happens when somebody forgets their password and there is nowhere to
# send a code: no linked chat, and no email configured above.
#
# on   the password is reset to their username and shown to whoever asked.
#      Anybody who knows an email address can do this, so it hands out
#      working credentials for any account with no chat linked.
# off  the request is refused. A forgotten password on an account with no
#      linked chat is then unrecoverable.
#
# There is no third option until this project can send email. A linked
# Telegram chat avoids the question entirely and is worth pushing users
# towards.
RESET_WITHOUT_CHAT=on

# ---- Twitch, for going live alerts ----
#
# From https://dev.twitch.tv/console/apps: Register Your Application, set
# the OAuth Redirect URL to your site (it is unused, but required), category
# Application Integration. Then Manage to see the client id and generate a
# secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# You generate this one, like the other secrets. Twitch signs every
# EventSub notification with it, and it is set when a subscription is
# created, so changing it means recreating every Twitch subscription.
TWITCH_EVENTSUB_SECRET=

# ---- Additional platforms ----

# RSSHub, for sites that publish nothing machine readable. Run the compose
# file in infra/rsshub/ and point this at it. Leave empty to switch the
# feature off: unmapped URLs then just report no feed found.
#
# Bound to localhost on purpose. An RSSHub reachable from the internet gets
# found and used by strangers, and then the sites it scrapes block your VPS
# rather than theirs.
RSSHUB_BASE_URL=http://127.0.0.1:1200

# ---- Web push ----

# Web push. Generate the pair once with:
#   npx web-push generate-vapid-keys
# Keep them: rotating invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:augy@augystudios.com
