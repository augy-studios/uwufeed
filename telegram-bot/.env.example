# telegram-bot environment
#
# Copy to telegram-bot/.env and fill in. Runs on the VPS, not on Vercel.
#
# Every value says where it comes from. Keep the file mode 600 and never
# commit the result.

# ---- Telegram credentials ----
#
# Two separate things, and both are needed. Telethon is a full MTProto
# client rather than a Bot API wrapper, so a bot token on its own is not
# enough.

# From https://my.telegram.org
#   1. Sign in with your phone number, confirm with the code Telegram sends
#      you in the app.
#   2. Open "API development tools".
#   3. Create an application. The name and short name are only shown to you.
#   4. Copy "App api_id" and "App api_hash".
#
# These belong to your Telegram account rather than to the bot, so they are
# reused across every bot you run. Treat the hash as a password.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From @BotFather in Telegram.
#   New bot:      send /newbot, pick a display name, then a username
#                 ending in "bot". It replies with the token.
#   Existing bot: send /mybots, pick the bot, then API Token.
#
# If it ever leaks, /revoke in BotFather issues a new one and kills the old
# one immediately.
TELEGRAM_BOT_TOKEN=

# ---- Supabase ----
#
# Supabase dashboard, your project, Project Settings, then API. The same
# project the site and the Discord bot use: sources, items and
# subscriptions are shared, only button state and preferences are local.

# Listed as "Project URL".
SUPABASE_URL=

# The secret service_role key on that page, not the anon one.
SUPABASE_SERVICE_KEY=

# ---- Shared with the site ----
#
# Neither of these is generated here. Both are copied from the main-site
# Vercel project, byte for byte. Making fresh ones means the site rejects
# everything this bot sends.

# The site's public origin. The bot hands URLs to /api/sources/resolve
# rather than detecting hubs itself, so that logic has one implementation.
PUBLIC_BASE_URL=https://feed.uwuapps.org

# Same value as ADMIN_TOKEN in Vercel. Without it, /add answers that adding
# sources is not configured.
ADMIN_TOKEN=

# Same value as LINK_TOKEN_SECRET in Vercel. The site signs link tokens,
# this bot verifies them, and neither talks to the other. A mismatch means
# every /link attempt is rejected as forged.
LINK_TOKEN_SECRET=

# ---- Local state ----
#
# No source needed, these are just paths and names.

# Bot local SQLite: button state, per chat preferences, scheduling, and the
# chat to account mapping. No feed data.
TELEGRAM_SQLITE_PATH=bot.sqlite3

# Name of the Telethon session file written next to main.py on first run.
# That file is a live credential: anyone holding it can act as the bot.
TELEGRAM_SESSION_NAME=uwufeed-telegram

# ---- Shown to users ----

WEB_APP_URL=https://feed.uwuapps.org
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# Free account cap, matching the site.
MAX_SOURCES_PER_USER=50
